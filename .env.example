# Copie este arquivo para ".env.local" e preencha com os dados do Supabase
# (Supabase → Project Settings → API). O .env.local não vai para o GitHub.

# Project URL
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública: "anon public" ou "publishable" (sb_publishable_...).
# NUNCA coloque aqui a chave "service_role"/"secret".
VITE_SUPABASE_ANON_KEY=
